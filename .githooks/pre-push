#!/usr/bin/env bash
# Optional local safety net: block direct publication to main/master, check the
# commits being updated for whitespace errors, then scan the working repository.
set -euo pipefail

hook_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "${hook_directory}/.." && pwd)
cd "${project_root}"

while read -r local_ref local_revision remote_ref remote_revision; do
  # Git supplies one ref update per line on stdin. All-zero revisions represent
  # branch creation/deletion and cannot form an ordinary old..new diff.
  if [[ "${remote_ref}" == "refs/heads/main" ||
        "${remote_ref}" == "refs/heads/master" ]]; then
    echo "error: direct pushes to ${remote_ref#refs/heads/} are blocked" >&2
    echo "push a topic branch and merge it through a reviewed pull request" >&2
    exit 1
  fi

  if [[ ! "${local_revision}" =~ ^0+$ &&
        ! "${remote_revision}" =~ ^0+$ ]]; then
    git diff --check "${remote_revision}..${local_revision}"
  fi
done

scripts/check-secrets.sh
