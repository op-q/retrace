# Local-only output, editor state, secrets, traces, and crash artifacts.

# Build products
/build/
/build-*/
/out/
/compile_commands.json
/CMakeUserPresets.json
/.cache/

# Editor and operating-system state
/.idea/
/.vscode/
*.swp
