*~
.DS_Store

# Secrets and local configuration
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# RETRACE output can contain sensitive process data
/.retrace/
*.rtc

# Crash artifacts
core
core.*
*.core
